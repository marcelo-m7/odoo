<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Security groups -->
    <record id="group_service_provider" model="res.groups">
        <field name="name">Service Provider</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_service_client" model="res.groups">
        <field name="name">Service Client</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <!-- Example record rules (placeholders) -->
    <!-- Providers can see only their own services -->
    <record id="rule_provider_own_services" model="ir.rule">
        <field name="name">Provider: own services</field>
        <field name="model_id" ref="model_service_map_service"/>
        <field name="groups" eval="[(4, ref('service_map.group_service_provider'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">['|', ('provider_id.partner_id.user_ids','in', user.id), ('provider_id.partner_id.id','=', user.partner_id.id)]</field>
    </record>

    <!-- Clients can see only their own requests -->
    <record id="rule_client_own_requests" model="ir.rule">
        <field name="name">Client: own requests</field>
        <field name="model_id" ref="model_service_map_request"/>
        <field name="groups" eval="[(4, ref('service_map.group_service_client'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('client_id','=', user.partner_id.id)]</field>
    </record>

</odoo>